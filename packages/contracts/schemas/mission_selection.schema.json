{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noor/mission_selection/0.1",
  "title": "Noor mission selection (draft 0.1, see docs/contracts/mission-selection.md)",
  "description": "Source of truth for POST /v1/missions/select. Change this first, then services/ai/app/missions/contracts.py in the same pull request. Selection only: the response is an id from the reviewed catalog, never text.",
  "$defs": {
    "missionId": { "type": "string", "pattern": "^MISSION_[A-Z0-9_]{1,56}$" },
    "valueId": { "type": "string", "pattern": "^VALUE_[A-Z0-9_]{1,58}$" },
    "level": { "enum": ["beginner", "intermediate", "advanced"] },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "level", "value"],
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "Opaque id for this request only. Never a child, family or session id."
        },
        "level": { "$ref": "#/$defs/level" },
        "value": { "$ref": "#/$defs/valueId" },
        "recentMissionIds": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/missionId" }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "missionId",
        "reasonRule",
        "selector",
        "catalogVersion",
        "promptVersion"
      ],
      "properties": {
        "requestId": { "type": "string" },
        "missionId": { "anyOf": [{ "$ref": "#/$defs/missionId" }, { "type": "null" }] },
        "reasonRule": {
          "enum": [
            "RULE_VALUE_MATCH",
            "RULE_VALUE_MATCH_REPEAT",
            "RULE_NO_MISSION",
            "AI_SELECTED",
            "RULE_FALLBACK_AI_INVALID",
            "RULE_FALLBACK_AI_ERROR"
          ]
        },
        "selector": { "type": "string", "minLength": 1 },
        "catalogVersion": { "type": "string", "minLength": 1 },
        "promptVersion": { "type": ["string", "null"] }
      }
    }
  },
  "examples": [
    {
      "request": {
        "requestId": "0b6e2c1a-1d2e-4f00-9a1b-2c3d4e5f6a7b",
        "level": "beginner",
        "value": "VALUE_HONESTY",
        "recentMissionIds": ["MISSION_HONESTY_KEEP_PROMISE"]
      },
      "response": {
        "requestId": "0b6e2c1a-1d2e-4f00-9a1b-2c3d4e5f6a7b",
        "missionId": "MISSION_HONESTY_TELL_TRUTH",
        "reasonRule": "RULE_VALUE_MATCH",
        "selector": "rules",
        "catalogVersion": "0.1-placeholder",
        "promptVersion": null
      }
    }
  ]
}
