{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noor/ai_result/3.0",
  "title": "Noor AI result (contract v3.0, see docs/contracts/ai-result.md)",
  "description": "Source of truth for the AI result. Change this first, then services/ai/app/schemas.py and packages/contracts/src/ai.ts in the same pull request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attemptId",
    "model",
    "modelVersion",
    "decision",
    "quality",
    "findings",
    "processingMs"
  ],
  "properties": {
    "attemptId": { "type": "string", "minLength": 1 },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "mock, quran-muaalem, whisper-quran, faster-whisper, combined, or none (API fallback)."
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Exact model revision, not just the package name (OPS-008)."
    },
    "decision": { "enum": ["accepted", "error", "uncertain"] },
    "quality": {
      "enum": ["ok", "silent", "too_short", "too_noisy", "too_long"],
      "description": "Anything but ok is a quality rejection: not an attempt (FR-QUR-003, VAL-014)."
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "processingMs": { "type": "integer", "minimum": 0 }
  },
  "allOf": [
    {
      "description": "A quality rejection is always uncertain with no findings.",
      "if": {
        "properties": { "quality": { "not": { "const": "ok" } } }
      },
      "then": {
        "properties": {
          "decision": { "const": "uncertain" },
          "findings": { "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wordIndex",
        "category",
        "code",
        "confidence",
        "wordStartMs",
        "wordEndMs",
        "messageKey"
      ],
      "properties": {
        "wordIndex": {
          "type": "integer",
          "minimum": 1,
          "description": "1 = first word of the ayah (same as position in the reference files)."
        },
        "category": { "enum": ["memorization", "pronunciation", "tajweed", "technical"] },
        "code": {
          "enum": [
            "ERR_MEM_OMISSION",
            "ERR_MEM_SUBSTITUTION",
            "ERR_MEM_INSERTION",
            "ERR_PRON_LETTER_SUB",
            "ERR_PRON_HARAKA",
            "ERR_PRON_MADD_ASLI_SHORT",
            "ERR_TAJ_MADD_SHORT",
            "ERR_TAJ_GHONNA_OMIT",
            "ERR_TAJ_QALQALA_OMIT",
            "ERR_TAJ_UNMAPPED",
            "ERR_TECH_MODELS_DISAGREE"
          ]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "wordStartMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Start of the word in the REFERENCE recitation, for replay."
        },
        "wordEndMs": {
          "type": "integer",
          "minimum": 0,
          "description": "End of the word in the reference recitation. Not before wordStartMs (checked in code)."
        },
        "messageKey": {
          "type": "string",
          "pattern": "^FEEDBACK_[A-Z_]+$",
          "description": "Key in safe_messages_v1_1.json. Model text is never shown to the child."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "category": { "const": "memorization" } } },
          "then": { "properties": { "code": { "pattern": "^ERR_MEM_" } } }
        },
        {
          "if": { "properties": { "category": { "const": "pronunciation" } } },
          "then": { "properties": { "code": { "pattern": "^ERR_PRON_" } } }
        },
        {
          "if": { "properties": { "category": { "const": "tajweed" } } },
          "then": { "properties": { "code": { "pattern": "^ERR_TAJ_" } } }
        },
        {
          "if": { "properties": { "category": { "const": "technical" } } },
          "then": { "properties": { "code": { "pattern": "^ERR_TECH_" } } }
        }
      ]
    }
  },
  "examples": [
    {
      "attemptId": "6650f0c2a1b2c3d4e5f60002",
      "model": "mock",
      "modelVersion": "0.2",
      "decision": "error",
      "quality": "ok",
      "findings": [
        {
          "wordIndex": 1,
          "category": "memorization",
          "code": "ERR_MEM_SUBSTITUTION",
          "confidence": 0.92,
          "wordStartMs": 0,
          "wordEndMs": 600,
          "messageKey": "FEEDBACK_WORD_DIFFERENT"
        }
      ],
      "processingMs": 15
    },
    {
      "attemptId": "6650f0c2a1b2c3d4e5f60004",
      "model": "mock",
      "modelVersion": "0.2",
      "decision": "uncertain",
      "quality": "too_short",
      "findings": [],
      "processingMs": 3
    }
  ]
}
