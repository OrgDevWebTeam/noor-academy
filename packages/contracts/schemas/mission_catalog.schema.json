{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noor/mission_catalog/0.1",
  "title": "Noor Family Loop mission catalog (draft 0.1)",
  "description": "The fixed, reviewed table that links a value to missions (safety doc 2.3, FR-AGT-004). Wording lives in the app's messages under textKey, never here and never from a model. Only reviewState 'approved' is served outside MOCK_MODE.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "missions"],
  "properties": {
    "version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "missions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value", "levels", "reviewState", "textKey"],
        "properties": {
          "id": { "type": "string", "pattern": "^MISSION_[A-Z0-9_]{1,56}$" },
          "value": { "type": "string", "pattern": "^VALUE_[A-Z0-9_]{1,58}$" },
          "levels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["beginner", "intermediate", "advanced"] }
          },
          "reviewState": { "enum": ["placeholder", "draft", "approved"] },
          "textKey": { "type": "string", "pattern": "^MISSION_TEXT_[A-Z0-9_]{1,50}$" }
        }
      }
    }
  }
}
