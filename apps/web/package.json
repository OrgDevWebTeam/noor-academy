    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.15.0",
    "eslint-config-next": "16.4.4",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4.3.3",
