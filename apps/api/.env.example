# Server
# development | staging | production
NODE_ENV=development
PORT=5000

# MongoDB Atlas
# Keep <PASSWORD> exactly as written in DATABASE. server.js replaces it with DATABASE_PASSWORD.
DATABASE=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/<DB_NAME>?appName=<APP_NAME>
DATABASE_PASSWORD=change-me

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

CLIENT_ORIGIN=http://localhost:5173