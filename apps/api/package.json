{
  "name": "@noor/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Express API (Node.js, TypeScript)",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "start:local": "tsc -p tsconfig.build.json && node --env-file=../../.env dist/server.js",
    "migrate": "node --env-file=../../.env scripts/migrate.mjs up",
    "migrate:down": "node --env-file=../../.env scripts/migrate.mjs down",
    "db:up": "docker compose -f ../../docker-compose.yml up -d --wait mongo",
    "services:up": "docker compose -f ../../docker-compose.yml up -d --wait --build mongo ai",
    "db:down": "docker compose -f ../../docker-compose.yml down",
    "db:reset": "docker compose -f ../../docker-compose.yml down -v",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev:idp": "node scripts/dev-idp.mjs"
  },
  "dependencies": {
    "@noor/contracts": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "mongodb": "^7.8.0",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@noor/config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
