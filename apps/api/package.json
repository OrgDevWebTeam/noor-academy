{
  "name": "@noor/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "description": "Noor Academy backend (Express, MongoDB)",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "start:local": "node --env-file=.env src/server.js",
    "test": "node --test --test-concurrency=1",
    "test:integration": "node --test --test-concurrency=1",
    "db:up": "docker compose -f ../../docker-compose.yml up -d --wait mongo",
    "services:up": "docker compose -f ../../docker-compose.yml up -d --wait --build mongo ai",
    "db:down": "docker compose -f ../../docker-compose.yml down",
    "db:reset": "docker compose -f ../../docker-compose.yml down -v"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0"
  }
}
