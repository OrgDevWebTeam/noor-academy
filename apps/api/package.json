{
  "name": "@noor/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS API (modular monolith)",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "start:local": "tsc -p tsconfig.build.json && node --env-file=../../.env dist/main.js",
    "db:up": "docker compose -f ../../docker-compose.yml up -d --wait mongo",
    "db:down": "docker compose -f ../../docker-compose.yml down",
    "db:reset": "docker compose -f ../../docker-compose.yml down -v"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/throttler": "^6.7.1",
    "@noor/contracts": "workspace:*",
    "helmet": "^8.3.0",
    "mongodb": "^7.8.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@noor/config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
