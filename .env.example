# Copy to .env for local development. NEVER commit real values.
# Real secrets live in the managed secret store (architecture 15.2).
# The browser only sees variables prefixed VITE_ - never put a secret in one.

# local | development | staging | production
APP_ENV=local
NODE_ENV=development

# --- API (server-side only) ---
HOST=127.0.0.1
PORT=4000
# fatal | error | warn | info | debug | trace | silent  (production may not use debug/trace)
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=100
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Local synthetic MongoDB from docker-compose.yml (directConnection skips replica-set discovery).
MONGODB_URI=mongodb://127.0.0.1:27018/?directConnection=true
MONGODB_DB=noor_local

# Identity provider (any OpenID Connect provider). Set all three or none; required in
# staging/production, which also require https:// URLs. Without them, every authenticated
# route returns 401 (there is no login bypass).
OIDC_ISSUER_URL=http://127.0.0.1:4010/
OIDC_AUDIENCE=noor-api
OIDC_JWKS_URL=http://127.0.0.1:4010/jwks.json

# --- Web (React/Vite; public by design) ---
VITE_APP_ENV=local
# Empty = same origin (the Vite dev server proxies /v1 to the API).
VITE_API_BASE_URL=
