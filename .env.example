# Copy to .env for local development. NEVER commit real values.
# Real secrets live in the managed secret store (architecture 15.2).
# Only variables prefixed NEXT_PUBLIC_ reach the browser - never put a secret in one.

# local | development | staging | production
APP_ENV=local
NODE_ENV=development

# --- API / worker (server-side only) ---
HOST=127.0.0.1
PORT=4000
# fatal | error | warn | info | debug | trace | silent  (production may not use debug/trace)
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=100
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Local synthetic database from docker-compose.yml
DATABASE_URL=mongodb://noor:noor@127.0.0.1:27018/noor_local?authSource=admin

# Pending OD-03 (identity provider):
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# --- Web (public by design) ---
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
